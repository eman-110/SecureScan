<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F9F9">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Secure Scan"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#0A3755"
        android:layout_marginTop="50dp"
        android:layout_gravity="center"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Secure Every Scan, Trust Every Code"
        android:textSize="14sp"
        android:textColor="#0A3755"
        android:layout_marginTop="6dp"
        android:gravity="center"/>

    <!-- Camera Preview Box -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center"
        android:layout_marginTop="20sp"
        android:background="@drawable/camera_placeholder"
        android:layout_marginBottom="20dp"/>

    <!-- Import from Gallery Button -->
    <Button
        android:id="@+id/buttonImportGallery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="   Import From Gallery              "
        android:backgroundTint="#A9CCE3"
        android:layout_gravity="center"
        android:layout_marginTop="80dp"
        android:background="@drawable/rounded_button"
        android:textColor="#0A3755"
        android:drawableEnd="@drawable/ic_gallery"
        android:padding="10dp"/>

    <!-- Bottom Navigation Bar -->

        <ImageButton
            android:id="@+id/buttonScanQR"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:background="@drawable/white_curved_bg"
            android:src="@drawable/ic_qr"
            android:layout_marginTop="40dp"
            android:contentDescription="Scan QR" />
</LinearLayout>