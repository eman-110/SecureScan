<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.securescan">
    <!-- Camera permission -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Declare camera hardware is used but not required -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SecureScan">


        <activity
            android:name=".Activity_Scan"
            android:exported="false" />
        <activity
            android:name=".Activity_Splash"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"> <!-- Make sure this is here -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>